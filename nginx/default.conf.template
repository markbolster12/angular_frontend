server {
    listen 80;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    # Angular client-side routing — unmatched paths fall through to the app shell.
    location / {
        try_files $uri $uri/ /index.html;
    }

    # Same-origin reverse proxy to the backend, so the browser never needs to know its
    # address and the backend never needs CORS. BACKEND_HOST/BACKEND_PORT are substituted
    # from the container's environment by nginx's built-in envsubst-on-templates entrypoint.
    # Resolved once at startup via the normal OS resolver (respects /etc/resolv.conf's
    # search domains, so a plain k8s Service name works) — safe to cache, since a Service's
    # ClusterIP is stable for its whole lifetime regardless of which pods back it.
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:${BACKEND_PORT};
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
